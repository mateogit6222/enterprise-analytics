# ============================================================
# Enterprise Analytics — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials.
# ============================================================

# API REST Mock — Base URL (simulated SQL/PostgreSQL backend)
API_REST_BASE_URL=http://localhost:3000/api

# Firestore Mock — Project Config (simulated NoSQL service)
FIRESTORE_PROJECT_ID=enterprise-analytics-mock
FIRESTORE_API_KEY=MOCK_KEY_NOT_REAL_12345

# JWT Secret (for mock token generation)
JWT_SECRET=MOCK_SECRET_DO_NOT_USE_IN_PRODUCTION

# App Configuration
APP_NAME=Enterprise Analytics
APP_VERSION=1.0.0
